# ─────────────────────────────────────────────────────────────────────────────
# F.O.R.G.E. Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── EVE Online SSO ───────────────────────────────────────────────────────────
# Register your app at: https://developers.eveonline.com/
# Callback URL must match exactly what is registered with CCP.
# Required scopes (add all of these to your EVE app registration):
#   esi-wallet.read_character_wallet.v1
#   esi-characters.read_blueprints.v1
#   esi-assets.read_assets.v1
#   esi-industry.read_character_jobs.v1
#   esi-skills.read_skills.v1
EVE_CLIENT_ID=your_eve_client_id_here
EVE_CLIENT_SECRET=your_eve_client_secret_here

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# EVE OAuth Client ID for the browser SSO redirect — must match EVE_CLIENT_ID above.
# Exposed to the browser (it appears in the OAuth redirect URL), but must not be
# the same secret as EVE_CLIENT_SECRET.
VITE_EVE_CLIENT_ID=your_eve_client_id_here

# ── Anthropic AI ─────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Corp / Security ──────────────────────────────────────────────────────────
# FORGE_CORP_KEY: 32+ char random string — AES-256-GCM key for corp token encryption
# Generate with: openssl rand -hex 32
FORGE_CORP_KEY=generate_a_long_random_string_here

# FORGE_REMEMBER_KEY: 32+ char random string — AES-256-GCM key for "Remember my
# characters" alt refresh tokens. Deliberately a DIFFERENT key from FORGE_CORP_KEY
# (separate blast radius: corp director tokens vs. individual players' alt tokens).
# Without this set, the remember-characters feature is disabled (fails safe, does
# not fall back to a predictable key). Generate with: openssl rand -hex 32
FORGE_REMEMBER_KEY=generate_a_different_long_random_string_here

# FORGE_ADMIN_KEY: secret for /api/admin/* endpoints
# Generate with: openssl rand -hex 24
FORGE_ADMIN_KEY=generate_another_random_string_here

# ── Docker / Cloudflare Tunnel (optional) ────────────────────────────────────
# Only needed if using the cloudflared Docker profile.
# Get token from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure → Install connector
# Run tunnel: docker compose --profile cloudflared up -d
TUNNEL_TOKEN=
