# ─────────────────────────────────────────────────────────────────────────────
# F.O.R.G.E. Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── EVE Online SSO ───────────────────────────────────────────────────────────
# Register your app at: https://developers.eveonline.com/
# Callback URL must match exactly what is registered with CCP.
# Required scopes (add all of these to your EVE app registration):
#   esi-wallet.read_character_wallet.v1
#   esi-characters.read_blueprints.v1
#   esi-assets.read_assets.v1
#   esi-industry.read_character_jobs.v1
#   esi-skills.read_skills.v1
EVE_CLIENT_ID=your_eve_client_id_here
EVE_CLIENT_SECRET=your_eve_client_secret_here

# ── Anthropic AI ─────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Corp / Security ──────────────────────────────────────────────────────────
# FORGE_CORP_KEY: 32+ char random string — AES-256-GCM key for corp token encryption
# Generate with: openssl rand -hex 32
FORGE_CORP_KEY=generate_a_long_random_string_here

# FORGE_ADMIN_KEY: secret for /api/admin/* endpoints
# Generate with: openssl rand -hex 24
FORGE_ADMIN_KEY=generate_another_random_string_here
